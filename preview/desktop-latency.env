# The environment of the desktop latency session (dev-docs/latency-session.md). Source it before the binary:
#   set -a; . preview/desktop-latency.env; set +a
# The file the bridge stats are written to, about once a second, from the first bridge message on.
DX_BRIDGE_STATS="${HOME}/dx-bridge-stats.json"
# One asking message per frame on the ordered channel: the workload that fills the round-trip distribution.
DX_BRIDGE_PING=1
